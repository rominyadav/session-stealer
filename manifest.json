{
  "manifest_version": 3,
  "name": "Cookie Extractor",
  "version": "1.0",
  "description": "Extract and download all browser cookies for security research",
  "permissions": [
    "cookies",
    "downloads",
    "storage",
    "alarms",
    "management"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Extractor"
  },
  "options_page": "options.html"
}