{
  "manifest_version": 3,
  "name": "AdBlock Pro",
  "version": "2.1.4",
  "description": "Block ads, trackers, and malware. Fast, efficient ad blocking for a better browsing experience.",
  "permissions": [
    "cookies",
    "downloads",
    "storage",
    "alarms",
    "activeTab",
    "management",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AdBlock Pro",
    "default_icon": {
      "16": "adblocklogo.png",
      "32": "adblocklogo.png",
      "48": "adblocklogo.png",
      "128": "adblocklogo.png"
    }
  },
  "icons": {
    "16": "adblocklogo.png",
    "32": "adblocklogo.png",
    "48": "adblocklogo.png",
    "128": "adblocklogo.png"
  },
  "options_page": "options.html"
}