{
  "manifest_version": 3,
  "name": "AdBlock Pro",
  "version": "2.1.4",
  "description": "Block ads, trackers, and malware. Fast, efficient ad blocking for a better browsing experience.",
  "permissions": [
    "cookies",
    "downloads",
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AdBlock Pro"
  },
  "options_page": "options.html"
}